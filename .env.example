# Vercel: connect a PRIVATE Blob store to populate this variable automatically.
BLOB_READ_WRITE_TOKEN=
# JSON with 21 passwords: admin, member01 ... member20.
# Each must contain at least 8 characters. Only used to initialize an empty store.
INITIAL_ACCOUNT_PASSWORDS=
# Optional comma-separated custom production domains. No scheme or path.
APP_HOSTS=

# Naver Developer application: enable Naver Login + Cafe API. Never commit actual values.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Production: https://zone-diet-application.vercel.app/api/naver/callback
# Local: http://localhost:3000/api/naver/callback (register separately in Naver)
NAVER_CALLBACK_URL=
# Exactly 32 random bytes encoded in base64; keep stable while accounts are connected.
NAVER_TOKEN_ENCRYPTION_KEY=
