# Vercel: connect a PRIVATE Blob store to populate this variable automatically.
BLOB_READ_WRITE_TOKEN=
# Leave blank for legacy storage (local file on localhost, private Blob on Vercel).
# Set to postgres only after schema installation, import and verification.
LEBEN_STORE=
# Server-side PostgreSQL URI from the dedicated Supabase project's connection pooler.
LEBEN_DATABASE_URL=
# Optional CA certificate for the database, PEM with real newlines or literal \n.
LEBEN_DATABASE_CA=
# Set to 1 on the serving deployment for final backup and cutover.
LEBEN_MAINTENANCE=
# JSON with an admin password. Include member01 ... member20 for the legacy demo roster.
# Each must contain at least 8 characters. Only used to initialize an empty store.
INITIAL_ACCOUNT_PASSWORDS=
# Optional comma-separated custom production domains. No scheme or path.
APP_HOSTS=

# Naver Developer application: enable Naver Login + Cafe API. Never commit actual values.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Production: https://zone-diet-application.vercel.app/api/naver/callback
# Local: http://localhost:3000/api/naver/callback (register separately in Naver)
NAVER_CALLBACK_URL=
# Exactly 32 random bytes encoded in base64; keep stable while accounts are connected.
NAVER_TOKEN_ENCRYPTION_KEY=
