{
  "name": "leben-zonda",
  "version": "0.1.0",
  "private": true,
  "description": "크로스핏 레벤 수업 예약, 박스 회원 관리, 존다 프로그램",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local --env-file-if-exists=config/.env.local server/index.js",
    "check": "node scripts/check.js",
    "check:motion": "node scripts/check.js client/guide/motion",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.js",
    "db": "node --env-file-if-exists=.env.local --env-file-if-exists=config/.env.local scripts/migrate-postgres.js",
    "check:db": "node scripts/check.js server/local.js server/storage server/db scripts/migrate-postgres.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "pg": "8.20.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
